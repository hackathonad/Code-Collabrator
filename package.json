{
  "name": "code-sphere-collab",
  "private": true,
  "version": "1.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "start": "npm run start --workspace server",
    "lint": "eslint client/src server/src",
    "test": "npm run test --workspace server && npm run test:client",
    "verify": "npm run build && npm run lint && npm test",
    "test:client": "npm exec --workspace server tsx -- --test ../client/test/mediaFoundation.test.ts ../client/test/executionFoundation.test.ts ../client/test/persistenceFoundation.test.ts ../client/test/agentProtocol.test.ts",
    "test:media-client": "npm exec --workspace server tsx -- --test ../client/test/mediaFoundation.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/static-build": "^2.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  }
}
