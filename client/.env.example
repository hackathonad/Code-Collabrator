# Leave blank to use the current Vercel origin in production and the Vite proxy in development.
VITE_API_URL=
VITE_SOCKET_URL=
# Optional public production URL used only for canonical and Open Graph URLs.
VITE_PUBLIC_SITE_URL=

# Browser-safe Supabase configuration. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
