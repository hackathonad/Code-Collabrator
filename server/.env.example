# Server. Set NODE_ENV=production on deployed backends.
NODE_ENV=development
PORT=4000
# Optional safety limits; values above the documented hard bounds fall back to defaults.
# API_RATE_LIMIT=180
# AI_REQUEST_RATE_LIMIT=20
# AGENT_REQUEST_RATE_LIMIT=12
# AGENT_PATCH_RATE_LIMIT=20
# AGENT_VALIDATION_RATE_LIMIT=8
# AGENT_MAX_ITERATIONS=8
# AGENT_MAX_TOOL_CALLS=20
# AGENT_TIMEOUT_MS=90000
# Comma-separated browser origins allowed to call the API and Socket.IO server.
CLIENT_URL=http://127.0.0.1:5173
# Required in production: unique, server-only, at least 32 characters.
GUEST_SESSION_SECRET=replace-this-in-production-with-a-long-random-secret

# Optional Supabase room persistence. Supabase Auth is not used.
# Guest room creation works without these values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local AI provider: Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional. When blank, Code Collaborator chooses the first discovered local model.
OLLAMA_MODEL=

# Optional hosted providers. These values remain on the server and are never
# sent to the browser. Leave blank to keep a provider unavailable in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional LiveKit media provider. All three values are required to enable calls.
# LIVEKIT_URL is the public websocket endpoint (ws:// for local development, wss:// in production).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
